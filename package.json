{
  "name": "@locallogic/serverless-lambda-edge-pre-existing-cloudfront",
  "version": "2.0.0",
  "description": "The Serverless Framework plugin which creates Lambda@Edge against pre-existing CloudFront.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "Local Logic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexmoov/serverless-lambda-edge-pre-existing-cloudfront.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "scripts": {
    "compile": "tsc",
    "build": "rm -rf dist && tsc",
    "lint": "eslint .",
    "fmt": "eslint --fix .",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/serverless": "^3.12.27",
    "@typescript-eslint/parser": "^8.46.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "osls": "^4.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.1096.0",
    "@aws-sdk/client-cloudfront": "^3.1096.0",
    "@aws-sdk/client-lambda": "^3.1096.0"
  },
  "packageManager": "npm@10.9.7"
}
